# 이 파일을 .env로 복사해서 값을 채워요. .env는 Git에 올리지 않아요.

# --- 키 (비워 두면 해당 기능만 동작하지 않아요) ---
DATABASE_URL=postgresql://localhost:5432/marketon
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
KAMIS_SERVICE_KEY=
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=

# --- 공공데이터·외부 API 추가 (Water, 2026-11-22) ---
# KAMIS_SERVICE_KEY, KMA_SERVICE_KEY, DATA_GO_KR_KEY 는 모두 같은 공공데이터포털 인증키예요.
# (호출 확인 결과: Water 브랜치 docs/data/API_데이터확인.md)
# DATA_GO_KR_KEY: 상가(상권)정보, 이달의 식재료, 관광음식 다국어 등 나머지 공공데이터포털 API용
DATA_GO_KR_KEY=
# 식품안전나라 레시피 DB(COOKRCP01). 공공데이터포털과 별개 키. http 주소라 서버에서만 호출
FOODSAFETY_KEY=
# 네이버 지도: ID는 화면용, Secret은 서버 전용(화면 코드에 넣지 않기)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# --- 손님 가격 제보: 기기 구분용 비밀값 (2026-11-25) ---
# 기기 ID를 그대로 저장하지 않고 이 값을 섞은 해시로만 저장해요 (개인정보 보호).
# 각자 무작위 값으로 한 번만 정하고 바꾸지 마세요 (바꾸면 기존 제보와 기기 연결이 끊겨요).
# 비워 두면 개발용 고정값을 써요. 시연·배포 서버에는 반드시 무작위 값을 넣어요.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_HASH_SALT=

# --- 자동입력 방지 숫자(캡차) (2026-11-26) ---
# 회원가입·입점 신청은 항상, 로그인은 같은 아이디로 2번 틀린 뒤부터 캡차를 확인해요. 외부 키 필요 없음.
# 프론트에 캡차 입력칸이 붙기 전에는 false로 꺼 둘 수 있어요. 시연·배포 서버는 반드시 true.
CAPTCHA_ENABLED=true

# --- OpenAI (선택, 2026-11-26) ---
# 사진 인식·질문 답변은 Gemma가 부족할 때만 GPT로, 채팅은 GPT가 먼저예요. 둘 다 비우면 Gemma만 써요.
# 키는 Market-On 전용 프로젝트 키로, OpenAI 대시보드에서 월 사용 한도를 꼭 걸어요.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# 아래 두 줄은 기본값 그대로 두세요. 빈 값(OPENAI_BASE_URL=, LLM_ROUTES=)으로 두면 서버가 뜨지 않아요.
# LLM_ROUTES는 기능별로 먼저 쓸 모델 순서예요(앞에서 실패하면 다음 모델). 한 줄 JSON으로 적어요.
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_ROUTES={"recognize":["gemma","openai"],"ask":["gemma","openai"],"recommend":["gemma","openai"],"chat":["openai","gemma"]}

# --- 설정 (빈 값으로 두면 서버가 뜨지 않아요. 기본값 그대로 두세요) ---
LLM_PROVIDER=gemma
EMBEDDING_PROVIDER=ollama
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://100.77.199.12:11434
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
CORS_ORIGINS=["http://localhost:5173"]

# --- 프론트 ---
# Vite는 frontend/.env 를 읽어요. 바꿀 때만 frontend/.env 에 적어요. 기본값은 /api (개발 서버 프록시).
# VITE_API_BASE_URL=/api
# API 모드: 적지 않으면 live(실제 서버). 백엔드 없이 화면만 볼 때 mock
# VITE_API_MODE=mock
# mock이어도 지도 키(/config/public)만 실제 서버에 물어 네이버 지도 위에 mock 핀을 그릴 때
# VITE_PUBLIC_CONFIG=live