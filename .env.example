# 이 파일을 .env로 복사해서 값을 채워요. .env는 Git에 올리지 않아요.

# --- 키 (비워 두면 해당 기능만 동작하지 않아요) ---
DATABASE_URL=postgresql://localhost:5432/marketon
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
KAMIS_SERVICE_KEY=
# 카카오: 앱 Market-On(ID 1668225), 카카오맵 사용 ON (2026-11-27). 지도는 네이버가 기본, 카카오는 예비용
# REST 키는 서버 전용(주소→좌표 등). JavaScript 키는 화면용이라 브라우저에 보이는 값이고, 등록한 도메인에서만 동작해요
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
KMA_SERVICE_KEY=

# --- 공공데이터·외부 API 추가 (Water, 2026-11-22) ---
# KAMIS_SERVICE_KEY, KMA_SERVICE_KEY, DATA_GO_KR_KEY 는 모두 같은 공공데이터포털 인증키예요.
# (호출 확인 결과: Water 브랜치 docs/data/API_데이터확인.md)
# DATA_GO_KR_KEY: 상가(상권)정보, 이달의 식재료, 관광음식 다국어 등 나머지 공공데이터포털 API용
DATA_GO_KR_KEY=
# 식품안전나라 레시피 DB(COOKRCP01). 공공데이터포털과 별개 키. http 주소라 서버에서만 호출
FOODSAFETY_KEY=
# 네이버 지도: ID는 화면용, Secret은 서버 전용(화면 코드에 넣지 않기)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# --- 손님 가격 제보: 기기 구분용 비밀값 (2026-11-25) ---
# 기기 ID를 그대로 저장하지 않고 이 값을 섞은 해시로만 저장해요 (개인정보 보호).
# 각자 무작위 값으로 한 번만 정하고 바꾸지 마세요 (바꾸면 기존 제보와 기기 연결이 끊겨요).
# 비워 두면 개발용 고정값을 써요. 시연·배포 서버에는 반드시 무작위 값을 넣어요.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_HASH_SALT=

# --- 자동입력 방지 숫자(캡차) (2026-11-26) ---
# 회원가입·입점 신청은 항상, 로그인은 같은 아이디로 2번 틀린 뒤부터 캡차를 확인해요. 외부 키 필요 없음.
# 프론트에 캡차 입력칸이 붙기 전에는 false로 꺼 둘 수 있어요. 시연·배포 서버는 반드시 true.
CAPTCHA_ENABLED=true

# --- OpenAI (선택, 2026-11-26) ---
# 모델은 역할별로 순서가 달라요 (아래 LLM_ROUTES, 작업 지시서 040). 외부 키를 다 비우면 Gemma만 써요.
# 키는 Market-On 전용 프로젝트 키로, OpenAI 대시보드에서 월 사용 한도를 꼭 걸어요.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# 아래 두 줄은 기본값 그대로 두세요. 빈 값(OPENAI_BASE_URL=, LLM_ROUTES=)으로 두면 서버가 뜨지 않아요.
# LLM_ROUTES는 역할별 모델 순서예요(앞에서 실패하면 다음 모델). 한 줄 JSON으로 적어요. (2026-11-27, 040)
#   route=질문 의도 나누기(규칙으로 안 될 때) · plan=대화 도구 고르기 · extract=긴 근거에서 사실만 뽑기
#   write=최종 한국어 답 · reason=장보기 이유 문장. 사진 품목 인식은 구글 비전만 써서 여기 없어요
#   예전 이름(recognize·ask·recommend·chat)만 적혀 있어도 서버는 뜨고 기본 순서를 써요. 새 줄로 바꿔 주세요
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_ROUTES={"route":["gemma","gemini","openai"],"plan":["gemini","openai"],"extract":["gemini","openai"],"write":["gemma","gemini","openai"],"reason":["gemini","openai","gemma"],"translate":["gemma"]}

# --- 제미나이 (2026-11-26) ---
# 제미나이는 대화 도구 고르기(plan)·긴 근거 정리(extract)·장보기 이유(reason)를 맡고, 젬마가 막히면 답(write)도 써요.
# 키는 맨 위 GEMINI_API_KEY (Google AI Studio). 무료 키는 보낸 내용이 Google 학습에 쓰일 수 있어요
# → 손님 개인정보를 보내지 않기. 사진은 AI 모델에 보내지 않아요 (품목 인식은 구글 비전)
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# 외부 AI(제미나이·GPT) 사용 규칙: 모델별 하루 전체 횟수, 손님(기기)별 1시간 횟수, 답변 최대 길이(토큰)
EXTERNAL_LLM_DAILY_LIMIT=500
EXTERNAL_LLM_HOURLY_PER_CLIENT=20
LLM_MAX_OUTPUT_TOKENS=2048

# --- 구글 비전 (사진 품목·가격표 글자, 2026-11-27, 040) ---
# 키는 맨 위 GOOGLE_VISION_API_KEY. 사진 1장 = 라벨 1건 + 글자 1건. 무료는 기능별 월 1,000건
# 하루 상한(사진 수)과 한 달 상한(사진 수, llm_calls 기록으로 셈). 한도에 걸리면 화면은 직접 고르기로
VISION_DAILY_LIMIT=300
VISION_MONTHLY_LIMIT=1000

# --- 배포 서버에서만 바꾸는 값 (2026-11-27) ---
# COOKIE_SECURE=true   ← https 배포 서버는 꼭 true (로그인 쿠키를 https에서만 보냄). 개발(http://localhost)은 기본 false
# SESSION_DAYS=30      ← 로그인 유지 일수
# MEDIA_DIR=           ← 사진 저장 폴더 (비우면 backend/storage)

# --- 설정 (빈 값으로 두면 서버가 뜨지 않아요. 기본값 그대로 두세요) ---
LLM_PROVIDER=gemma
EMBEDDING_PROVIDER=ollama
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://100.77.199.12:11434
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
CORS_ORIGINS=["http://localhost:5173"]

# --- 프론트 ---
# Vite는 frontend/.env 를 읽어요. 바꿀 때만 frontend/.env 에 적어요. 기본값은 /api (개발 서버 프록시).
# VITE_API_BASE_URL=/api
# API 모드: 적지 않으면 live(실제 서버). 백엔드 없이 화면만 볼 때 mock
# VITE_API_MODE=mock
# mock이어도 지도 키(/config/public)만 실제 서버에 물어 네이버 지도 위에 mock 핀을 그릴 때
# VITE_PUBLIC_CONFIG=live
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# translate는 Gemma 전용. 장애·번역 검사 실패 시 한국어 원문(translated: false).
