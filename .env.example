# 이 파일을 .env로 복사해서 값을 채워요. .env는 Git에 올리지 않아요.

# --- 키 (비워 두면 해당 기능만 동작하지 않아요) ---
DATABASE_URL=postgresql://localhost:5432/marketon
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
KAMIS_SERVICE_KEY=
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=

# --- 설정 (빈 값으로 두면 서버가 뜨지 않아요. 기본값 그대로 두세요) ---
LLM_PROVIDER=gemini
EMBEDDING_DIM=768
CORS_ORIGINS=["http://localhost:5173"]

# --- 프론트 ---
# Vite는 frontend/.env 를 읽어요. 바꿀 때만 frontend/.env 에 적어요. 기본값은 /api (개발 서버 프록시).
# VITE_API_BASE_URL=/api
