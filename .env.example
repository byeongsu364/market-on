# ============================================================
# Market-On 환경변수 양식
# 이 파일을 복사해 이름을 .env 로 바꾸고 실제 값을 넣으세요.
# .env 는 절대 커밋하지 않습니다 (.gitignore 에 이미 포함).
# [P0] 시연에 꼭 필요 · [P1]/[P2] 해당 기능 만들 때 · [선택] 안 쓸 수도 있음
# 자세한 내용: docs/data/API_목록.md, docs/data/API_데이터확인.md
# ============================================================


# ------------------------------------------------------------
# 1. 공공데이터포털 (data.go.kr)  [P0]  9개 호출 확인 완료
#    계정당 인증키 1개로 아래 API를 모두 씀. API마다 '활용신청'만 따로.
#    발급: data.go.kr > 마이페이지 > 데이터 활용 > Open API > 일반 인증키
#    - KAMIS 기간별 소매가격 (15156065)          B552845/periodRetail/price    A4·A7 (소매만, 시장별)
#    - KAMIS 일별 도·소매 가격 (15156057)        B552845/perDay/price          A4·A7 (도매+소매, 시장별)
#    - KAMIS 지역별 도·소매 가격 (15156062)      B552845/perRegion/price       B3 (지역 평균)
#    - KAMIS 최근일자 도·소매가격 (15156063)     B552845/recent/price          홈 화면
#    - KAMIS 가격 추이 (15156069)               B552845/priceSequel/info      시세 추이
#    - 소상공인 상가(상권)정보 (15012005)        B553077/api/open/sdsc2/...    E1
#    - 기상청 단기예보 (15084084)               1360000/VilageFcstInfoService_2.0/getVilageFcst  F5
#    - 농식품 이달의 식재료 (15168024)          1390803/allbaroFoodMonth/...  D2
#    - 한국관광공사 관광음식 (15174840)         B551011/FoodService/...       G3
#    주의: 초당 호출 제한 있음 → 1초 간격, 날짜는 yyyyMMdd
# ------------------------------------------------------------
DATA_GO_KR_KEY=


# ------------------------------------------------------------
# 2. 식품안전나라 (foodsafetykorea.go.kr)  [P1]  호출 확인 완료
#    공공데이터포털과 별개 키. 회원가입 후 레시피 DB 페이지에서 'OpenAPI 이용신청'.
#    - 조리식품의 레시피 DB (COOKRCP01)  F1·F2
#    주의: http 주소라 서버에서만 호출 (브라우저에서 부르면 막힘)
# ------------------------------------------------------------
FOODSAFETY_KEY=


# ------------------------------------------------------------
# 3. 네이버 지도  [P0: 지도]  추후 API 입력 예정 (카카오 대신)
#    시장 위치 표시·길 안내. 시장 안 미니맵(E2)은 직접 그린 평면도(SVG)
#    변수 이름은 지도 담당 코드에 맞출 것
# ------------------------------------------------------------
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=


# ------------------------------------------------------------
# 4. 알림 (I2 마감 할인)  [P2]
# ------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
