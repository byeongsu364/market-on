# 이 파일을 .env로 복사해서 값을 채워요. .env는 Git에 올리지 않아요.

# --- 키 (비워 두면 해당 기능만 동작하지 않아요) ---
DATABASE_URL=postgresql://localhost:5432/marketon
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
KAMIS_SERVICE_KEY=
KAKAO_REST_API_KEY=
KMA_SERVICE_KEY=

# --- 공공데이터·외부 API 추가 (Water, 2026-11-22) ---
# KAMIS_SERVICE_KEY, KMA_SERVICE_KEY, DATA_GO_KR_KEY 는 모두 같은 공공데이터포털 인증키예요.
# (호출 확인 결과: Water 브랜치 docs/data/API_데이터확인.md)
# DATA_GO_KR_KEY: 상가(상권)정보, 이달의 식재료, 관광음식 다국어 등 나머지 공공데이터포털 API용
DATA_GO_KR_KEY=
# 식품안전나라 레시피 DB(COOKRCP01). 공공데이터포털과 별개 키. http 주소라 서버에서만 호출
FOODSAFETY_KEY=
# 네이버 지도 (추후 API 입력 예정)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# --- 설정 (빈 값으로 두면 서버가 뜨지 않아요. 기본값 그대로 두세요) ---
LLM_PROVIDER=gemma
EMBEDDING_PROVIDER=ollama
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
CORS_ORIGINS=["http://localhost:5173"]

# --- 프론트 ---
# Vite는 frontend/.env 를 읽어요. 바꿀 때만 frontend/.env 에 적어요. 기본값은 /api (개발 서버 프록시).
# VITE_API_BASE_URL=/api